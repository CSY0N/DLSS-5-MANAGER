<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DLSS_5_MANAGER.Views.ScreenView" x:DataType="vm:ScreenViewModel" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True" xmlns:vm="using:DLSS_5_MANAGER.ViewModels">
  <UserControl.Resources>
    <!-- The bars use PillSlider from App.axaml, shared with Settings. -->
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Darker over a bright background picture - see GlareScreenCardBrush in App.axaml. -->
    <Style Selector="Border.ScreenCard">
      <Setter Property="Background" Value="{DynamicResource GlareScreenCardBrush}" />
      <Setter Property="BorderBrush" Value="#25FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="TextBlock.SectionTitle">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="LetterSpacing" Value="2" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- The small panels that open from the shortcut and guide buttons. The
         popup's own chrome is cleared so only the app's panel shows. -->
    <Style Selector="FlyoutPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Border.ShortcutPanel">
      <Setter Property="Background" Value="#F70B1214" />
      <Setter Property="BorderBrush" Value="#2EFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <!-- The key cap: the shortcut as it is now, big enough to read at a glance. -->
    <Style Selector="Button.ShortcutCap">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,11" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

  </UserControl.Styles>
  <ScrollViewer x:Name="ScreenScrollViewer" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" BringIntoViewOnFocusChange="False">
    <Border x:Name="ScreenRoot" Padding="28,14,28,90">
      <StackPanel Spacing="12" MaxWidth="1040">
        <!-- The page as laid out in round 29 (the person's own sketch):
               top bar      the name, the card, the way out - and the source:
                            one button, then a click on the game
               DLSS 5       everything about the network, shown
               EFFECT       folded
               DLSS MFG     (RTX) or FLOW MFG (AMD MODE) in its place, shown
               COLOURS/HDR  folded
               FPS / VRR    shown
               COMPARISON   shown
               source list, presets, settings, capture, overlay: folded
             A folded card opens from its title, like the sections of Settings. -->
        <!-- The header sits on the picture: the plate behind it only shows while
             the picture is bright (GlareBackingBrush). The name is on the plate
             so the overlay, which hides the header, hides both. -->
        <Border x:Name="ScreenHeader" Margin="-6,-2,-6,2" Padding="10,6" CornerRadius="16"
                Background="{DynamicResource GlareBackingBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="LIVE FLOW" FontSize="20" FontWeight="Bold" LetterSpacing="1.6" VerticalAlignment="Center" />
            <!-- The card that does the work, beside the name of the section
                 doing it - as tall as the buttons it stands between (round 30:
                 it was a footnote beside a headline). -->
            <Border Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10"
                    Padding="12,0" Height="34" VerticalAlignment="Center" IsVisible="{Binding HasGpuText}">
              <TextBlock Text="{Binding GpuText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
            </Border>
            <!-- The way out of the ready state, and the way back in - the same
                 place, one of them showing at a time. -->
            <Button Classes="AppleSecondaryBtn" Content="{Binding Loc.LfStop}" Command="{Binding StopCommand}"
                    IsVisible="{Binding CanStop}" Focusable="False" ToolTip.Tip="{Binding Loc.LfStopHint}" VerticalAlignment="Center" />
            <Button Classes="ApplePrimaryBtn" Content="{Binding Loc.LfStart}" Command="{Binding StartCommand}"
                    IsVisible="{Binding CanStart}" Focusable="False" ToolTip.Tip="{Binding Loc.LfStartHint}" VerticalAlignment="Center" />
          </StackPanel>
          <!-- The status takes what is left between the two sides and no more.
               Cut short, the whole sentence is one hover away. -->
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="{Binding Status}" Foreground="#CBD5E1" VerticalAlignment="Center" HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
            <Ellipse Grid.Column="1" Width="16" Height="16" Stroke="#76B900" StrokeThickness="2" StrokeDashArray="2.6,1.6" StrokeLineCap="Round" IsVisible="{Binding IsPreparing}" RenderTransformOrigin="50%,50%">
              <Ellipse.Styles><Style Selector="Ellipse"><Style.Animations><Animation Duration="0:0:1.1" IterationCount="Infinite"><KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame><KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame></Animation></Style.Animations></Style></Ellipse.Styles>
            </Ellipse>
          </Grid>
          <!-- The source, the way Lossless Scaling does it: press, then click
               the game - when the count runs out, the window in front is
               taken. Round 37: only while "Select window" is on in Settings;
               off, LIVE FLOW and MFG take the whole screen (round 33). -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsEnabled="{Binding IsReady}"
                      IsVisible="{Binding IsWindowPickOn}">
            <TextBlock Text="{Binding SourceText}" IsVisible="{Binding HasSourceText}" FontSize="11.5" Foreground="#94A3B8"
                       VerticalAlignment="Center" MaxWidth="230" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceText}" />
            <Button Classes="ApplePrimaryBtn" Command="{Binding SelectActiveSourceCommand}" Focusable="False"
                    Content="{Binding SelectSourceText}" ToolTip.Tip="{Binding Loc.LfSelectWindowHint}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        </Border>
        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#FF9C8A" TextWrapping="Wrap" />
        <TextBlock x:Name="NoResults" Text="No Screen options match your search." IsVisible="{Binding NoSearchResults}" Foreground="#94A3B8" />
        <!-- AMD MODE: LIVE FLOW runs its Radeon version. ALPHA on its face -
             it was built without an AMD card to test on, and says so. -->
        <Border x:Name="AmdNotice" Classes="ScreenCard" IsVisible="{Binding IsRadeonMode}">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Background="#26EF4444" BorderBrush="#66EF4444" BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                <TextBlock Text="ALPHA" FontSize="10" FontWeight="Bold" Foreground="#FCA5A5" LetterSpacing="0.6" />
              </Border>
              <TextBlock Text="{Binding Loc.LfRadeonTitle}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" LineHeight="20" Text="{Binding Loc.LfRadeonNotice}" />
          </StackPanel>
        </Border>

        <!-- ================= DLSS 5 ================= -->
        <Border x:Name="ProcessingCard" Classes="ScreenCard" IsVisible="{Binding ShowProcessing}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="10">
            <TextBlock Classes="SectionTitle" Text="DLSS 5" HorizontalAlignment="Center" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto">
              <Grid ColumnDefinitions="*,Auto" Grid.Column="0" Grid.Row="0">
                <TextBlock Text="{Binding Loc.LfDlss5}" VerticalAlignment="Center" />
                <Border Grid.Column="1" CornerRadius="19" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                  <UniformGrid Columns="2">
                    <Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding !Nr}" Content="{Binding Loc.LfOff}" Command="{Binding NrOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding Nr}" Content="{Binding Loc.LfOn}" Command="{Binding NrOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </UniformGrid>
                </Border>
              </Grid>
              <!-- Flow Super Resolution beside DLSS 5: its internal size is the
                   resolution slider's below; the output is always the display's
                   (see WorkSize: "internal → output"). -->
              <Grid ColumnDefinitions="*,Auto" Grid.Column="1" Grid.Row="0" ToolTip.Tip="{Binding Loc.LfUpscalerHint}">
                <TextBlock Text="{Binding Loc.LfUpscaler}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" CornerRadius="19" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                  <UniformGrid Columns="2">
                    <Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding !Upscaler}" Content="{Binding Loc.LfOff}" Command="{Binding UpscalerOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding Upscaler}" Content="{Binding Loc.LfOn}" Command="{Binding UpscalerOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </UniformGrid>
                </Border>
              </Grid>
              <!-- The four sliders: the label carries its own value, then the
                   bar. One shape for all of them, so the two columns line up
                   two by two. The label column is fixed, which is what makes
                   the bars start and finish at the same place down both sides. -->
              <Grid ColumnDefinitions="168,*" ColumnSpacing="12" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"
                    IsEnabled="{Binding CanMultiPass}" ToolTip.Tip="{Binding MultiPassTip}" ToolTip.ShowOnDisabled="True">
                <TextBlock Text="{Binding PassCountLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Slider Grid.Column="1" Theme="{StaticResource PillSlider}" Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PassCount, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="168,*" ColumnSpacing="12" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" ToolTip.Tip="{Binding Loc.LfDenoiserHint}">
                <TextBlock Text="{Binding DenoiserLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Slider Grid.Column="1" Theme="{StaticResource PillSlider}" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Denoiser, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="168,*" ColumnSpacing="12" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" ToolTip.Tip="{Binding Loc.LfSharpnessHint}">
                <TextBlock Text="{Binding SharpnessLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Slider Grid.Column="1" Theme="{StaticResource PillSlider}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Sharpness, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="168,*" ColumnSpacing="12" Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" ToolTip.Tip="{Binding Loc.LfEdgeSmoothingHint}">
                <TextBlock Text="{Binding EdgeSmoothingLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Slider Grid.Column="1" Theme="{StaticResource PillSlider}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding EdgeSmoothing, Mode=TwoWay}" />
              </Grid>
            </Grid>
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Loc.LfNetworkResolution}" />
                <TextBlock Grid.Column="1" Text="{Binding WorkSize}" Foreground="#94A3B8" />
              </Grid>
              <Slider Theme="{StaticResource PillSlider}" Minimum="0.1" Maximum="{Binding ScaleCap}" Value="{Binding WorkScale, Mode=TwoWay}" TickFrequency="0.05" IsSnapToTickEnabled="True" />
              <!-- Centred under the slider they set. -->
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <Button Classes="SegmentedTab" Content="{Binding Loc.LfFast}" Command="{Binding FastResolutionCommand}" Padding="15,4" />
                <Button Classes="SegmentedTab" Content="{Binding Loc.LfBalanced}" Command="{Binding BalancedResolutionCommand}" Padding="15,4" />
                <Button Classes="SegmentedTab" Content="{Binding Loc.LfQuality}" Command="{Binding QualityResolutionCommand}" Padding="15,4" />
              </StackPanel>
            </StackPanel>
            <!-- Round 39: the network's model - Quality is NVIDIA's model A (what NeuralScreen runs), Fast its smaller B. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" ToolTip.Tip="{Binding Loc.LfNrModelHint}">
              <TextBlock Text="{Binding Loc.LfNrModel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <ComboBox Grid.Column="1" Classes="GlassComboBox" Width="200" MinWidth="200" VerticalAlignment="Center"
                        ItemsSource="{Binding NrModels}" SelectedIndex="{Binding NrModelIndex, Mode=TwoWay}" />
            </Grid>
          </StackPanel>
        </Border>


        <!-- ================= MULTI FRAME GENERATION (round 33) =================
             MFG SUPER MOTION's frame generation, moved in as it is: its
             generators (DLSS MFG on RTX cards, XeSS MFG, SMFG on any card), its options, its
             engine (downloaded once - SmfgStore). It works on the whole
             screen, like LIVE FLOW. With DLSS 5 on, LIVE FLOW hands it every
             finished frame (lf_msm_link.inl). VRR, the frame limit, the FPS
             counter, HDR and Spout are LIVE FLOW's own switches, shared. -->
        <Border x:Name="SmfgCard" Classes="ScreenCard" IsVisible="{Binding ShowSmfg}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="10">
            <TextBlock Classes="SectionTitle" Text="{Binding TitleSmfg}" HorizontalAlignment="Center" />
            <!-- Round 37: the engine comes with the app (mod files\native\supermotion\Engine) - nothing to download.
                 Only if it is gone from there does the card say so. -->
            <TextBlock Text="{Binding Smfg.EngineText}" Foreground="#F59E0B" TextWrapping="Wrap" IsVisible="{Binding Smfg.NeedsEngine}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" IsEnabled="{Binding Smfg.IsInstalled}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="0" Grid.Row="0"><TextBlock Text="MFG" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><Border CornerRadius="19" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center"><UniformGrid Columns="2"><Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding !Smfg.IsOn}" Content="{Binding Loc.LfOff}" Command="{Binding Smfg.OffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /><Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding Smfg.IsOn}" Content="{Binding Loc.LfOn}" Command="{Binding Smfg.OnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /></UniformGrid></Border></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="1" Grid.Row="0"><TextBlock Text="{Binding Loc.LfSmfgGenerator}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><ComboBox Classes="GlassComboBox" Width="160" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Smfg.Generators}" SelectedIndex="{Binding Smfg.GeneratorIndex, Mode=TwoWay}" /></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="0" Grid.Row="1"><TextBlock Text="{Binding Loc.LfSmfgMode}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><ComboBox Classes="GlassComboBox" Width="160" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Smfg.Modes}" SelectedIndex="{Binding Smfg.ModeIndex, Mode=TwoWay}" /></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="1" Grid.Row="1"><TextBlock Text="{Binding Loc.LfSmfgGameType}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><ComboBox Classes="GlassComboBox" Width="160" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Smfg.GameTypes}" SelectedIndex="{Binding Smfg.GameTypeIndex, Mode=TwoWay}" /></Border></Grid>
              <StackPanel Spacing="8" Grid.Column="0" Grid.Row="2" IsVisible="{Binding Smfg.IsFlowOpen}"><TextBlock Text="{Binding Smfg.FlowLabel}" TextTrimming="CharacterEllipsis" /><Slider Theme="{StaticResource PillSlider}" Minimum="25" Maximum="100" Value="{Binding Smfg.Flow, Mode=TwoWay}" /></StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="1" Grid.Row="2" IsVisible="{Binding Smfg.IsDlss}"><TextBlock Text="{Binding Loc.LfSmfgDlssPreset}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><ComboBox Classes="GlassComboBox" Width="160" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Smfg.DlssPresets}" SelectedIndex="{Binding Smfg.DlssPresetIndex, Mode=TwoWay}" /></Border></Grid>
              <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" Text="{Binding Loc.LfSmfgPresetCWarning}" Foreground="#F59E0B" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Smfg.IsPresetCPicked}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" IsVisible="{Binding Smfg.HasStatus}">
              <TextBlock Text="{Binding Smfg.StatusText}" FontSize="12.5" Foreground="#4ADE80" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ================= MULTI FRAME GENERATION, ADVANCED (folded) ================= -->
        <Border x:Name="SmfgAdvancedCard" Classes="ScreenCard" IsVisible="{Binding ShowSmfg}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="10">
            <Button Classes="SectionHeader" Click="OnToggleSection" Tag="smfg" Cursor="Hand">
              <Grid ColumnDefinitions="24,*,24">
                <TextBlock Grid.Column="1" Classes="SectionTitle" Text="{Binding Loc.LfSmfgAdvanced}" HorizontalAlignment="Center" />
                <Border Grid.Column="2" Classes="SectionChevron">
                  <PathIcon Data="{Binding SmfgChevron}" Width="9" Height="9" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  IsVisible="{Binding IsSmfgOpen}" IsEnabled="{Binding Smfg.IsInstalled}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="0" Grid.Row="0"><TextBlock Text="{Binding Loc.LfSmfgUpscaler}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><ComboBox Classes="GlassComboBox" Width="160" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Smfg.Upscalers}" SelectedIndex="{Binding Smfg.UpscalerIndex, Mode=TwoWay}" /></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="1" Grid.Row="0"><TextBlock Text="{Binding Loc.LfSmfgQueue}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><ComboBox Classes="GlassComboBox" Width="160" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Smfg.QueueTargets}" SelectedIndex="{Binding Smfg.QueueTargetIndex, Mode=TwoWay}" /></Border></Grid>
              <StackPanel Spacing="8" Grid.Column="0" Grid.Row="1" IsVisible="{Binding Smfg.IsSharpnessOpen}"><TextBlock Text="{Binding Smfg.SharpnessLabel}" TextTrimming="CharacterEllipsis" /><Slider Theme="{StaticResource PillSlider}" Minimum="0" Maximum="100" Value="{Binding Smfg.Sharpness, Mode=TwoWay}" /></StackPanel>
              <StackPanel Spacing="8" Grid.Column="1" Grid.Row="1" IsVisible="{Binding Smfg.IsOverSharpnessOpen}"><TextBlock Text="{Binding Smfg.OverSharpnessLabel}" TextTrimming="CharacterEllipsis" /><Slider Theme="{StaticResource PillSlider}" Minimum="0" Maximum="100" Value="{Binding Smfg.OverSharpness, Mode=TwoWay}" /></StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="0" Grid.Row="2"><TextBlock Text="{Binding Loc.LfSmfgScreenLimit}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><Border CornerRadius="19" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center"><UniformGrid Columns="2"><Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding !Smfg.LimitToScreen}" Content="{Binding Loc.LfOff}" Command="{Binding Smfg.LimitToScreenOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /><Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding Smfg.LimitToScreen}" Content="{Binding Loc.LfOn}" Command="{Binding Smfg.LimitToScreenOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /></UniformGrid></Border></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="1" Grid.Row="2"><TextBlock Text="{Binding Loc.LfLowLatency}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><Border CornerRadius="19" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center"><UniformGrid Columns="2"><Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding !Smfg.LowLatency}" Content="{Binding Loc.LfOff}" Command="{Binding Smfg.LowLatencyOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /><Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding Smfg.LowLatency}" Content="{Binding Loc.LfOn}" Command="{Binding Smfg.LowLatencyOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /></UniformGrid></Border></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="0" Grid.Row="3"><TextBlock Text="{Binding Loc.LfSmfgSync}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><ComboBox Classes="GlassComboBox" Width="160" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Smfg.SyncModes}" SelectedIndex="{Binding Smfg.SyncModeIndex, Mode=TwoWay}" /></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="1" Grid.Row="3"><TextBlock Text="{Binding Loc.LfSmfgMotion}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><ComboBox Classes="GlassComboBox" Width="160" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Smfg.MotionChoices}" SelectedIndex="{Binding Smfg.MotionIndex, Mode=TwoWay}" /></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="0" Grid.Row="4"><TextBlock Text="{Binding Loc.LfSmfgStill}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><Border CornerRadius="19" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center"><UniformGrid Columns="2"><Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding !Smfg.StillPixels}" Content="{Binding Loc.LfOff}" Command="{Binding Smfg.StillPixelsOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /><Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding Smfg.StillPixels}" Content="{Binding Loc.LfOn}" Command="{Binding Smfg.StillPixelsOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /></UniformGrid></Border></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="1" Grid.Row="4" ToolTip.Tip="{Binding Loc.LfSmfgGameFpsHelp}"><TextBlock Text="{Binding Loc.LfSmfgGameFps}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><ComboBox Classes="GlassComboBox" Width="160" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Smfg.GameFpsChoices}" SelectedIndex="{Binding Smfg.GameFpsIndex, Mode=TwoWay}" /></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="0" Grid.Row="5"><TextBlock Text="{Binding Loc.LfSmfgGpu}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><ComboBox Classes="GlassComboBox" Width="160" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Smfg.GpuChoices}" SelectedIndex="{Binding Smfg.GpuIndex, Mode=TwoWay}" /></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="1" Grid.Row="5"><TextBlock Text="{Binding Loc.LfSmfgPriority}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><ComboBox Classes="GlassComboBox" Width="160" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Smfg.GpuPriorities}" SelectedIndex="{Binding Smfg.GpuPriorityIndex, Mode=TwoWay}" /></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="0" Grid.Row="6"><TextBlock Text="{Binding Loc.LfSmfgCapture}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><ComboBox Classes="GlassComboBox" Width="160" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Smfg.CaptureApis}" SelectedIndex="{Binding Smfg.CaptureApiIndex, Mode=TwoWay}" /></Border></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="1" Grid.Row="6"><TextBlock Text="{Binding Loc.LfSmfgShortcut}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1"><TextBlock Text="{Binding Smfg.ShortcutText}" Foreground="#CBD5E1" VerticalAlignment="Center" /></Border></Grid>
            </Grid>
          </StackPanel>
        </Border>

        <!-- ================= EFFECT (folded) ================= -->
        <Border x:Name="EffectCard" Classes="ScreenCard" IsVisible="{Binding ShowEffect}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="10">
            <Button Classes="SectionHeader" Click="OnToggleSection" Tag="effect" Cursor="Hand">
              <Grid ColumnDefinitions="24,*,24">
                <TextBlock Grid.Column="1" Classes="SectionTitle" Text="{Binding TitleEffect}" HorizontalAlignment="Center" />
                <Border Grid.Column="2" Classes="SectionChevron">
                  <PathIcon Data="{Binding EffectChevron}" Width="9" Height="9" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" IsVisible="{Binding IsEffectOpen}">
              <!-- Keep colours (round 29): the picture keeps its own colour and
                   takes the network's light and detail. 100% unless moved. -->
              <Grid ColumnDefinitions="168,*" ColumnSpacing="12" Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" ToolTip.Tip="{Binding Loc.LfKeepColorsHint}">
                <TextBlock Text="{Binding KeepColorsLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Slider Grid.Column="1" Theme="{StaticResource PillSlider}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding KeepColors, Mode=TwoWay}" />
              </Grid>
              <!-- Low-light noise (round 34): the dark parts smoothed edge-aware
                   where the network's result goes back on the picture. 0 = off. -->
              <Grid ColumnDefinitions="168,*" ColumnSpacing="12" Grid.Column="1" Grid.Row="3" VerticalAlignment="Center" ToolTip.Tip="{Binding Loc.LfLowLightHint}">
                <TextBlock Text="{Binding LowLightLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Slider Grid.Column="1" Theme="{StaticResource PillSlider}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding LowLight, Mode=TwoWay}" />
              </Grid>
              <StackPanel Spacing="8" Grid.Column="0" Grid.Row="0">
                <TextBlock Text="{Binding Loc.LfProfile}" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="1" Grid.Row="0">
                <TextBlock Text="{Binding Loc.LfModel}" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Models}" SelectedIndex="{Binding ModelIndex, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="0" Grid.Row="1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Loc.LfIntensity}" />
                  <TextBlock Grid.Column="1" Text="{Binding Intensity, StringFormat={}{0:F2}}" />
                </Grid>
                <Slider Theme="{StaticResource PillSlider}" Minimum="0" Maximum="3" Value="{Binding Intensity, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="1" Grid.Row="1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Loc.LfLocalTone}" />
                  <TextBlock Grid.Column="1" Text="{Binding LocalTone, StringFormat={}{0:F2}}" />
                </Grid>
                <Slider Theme="{StaticResource PillSlider}" Minimum="0" Maximum="2" Value="{Binding LocalTone, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="0" Grid.Row="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Loc.LfLocalStructure}" />
                  <TextBlock Grid.Column="1" Text="{Binding LocalStructure, StringFormat={}{0:F2}}" />
                </Grid>
                <Slider Theme="{StaticResource PillSlider}" Minimum="0" Maximum="2" Value="{Binding LocalStructure, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="1" Grid.Row="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Loc.LfSkinStructure}" />
                  <TextBlock Grid.Column="1" Text="{Binding SkinStructure, StringFormat={}{0:F2}}" />
                </Grid>
                <Slider Theme="{StaticResource PillSlider}" Minimum="-1" Maximum="2.5" Value="{Binding SkinStructure, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- ================= COLOURS / HDR (folded) ================= -->
        <Border x:Name="ColorsCard" Classes="ScreenCard" IsVisible="{Binding ShowColors}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="10">
            <Button Classes="SectionHeader" Click="OnToggleSection" Tag="colors" Cursor="Hand">
              <Grid ColumnDefinitions="24,*,24">
                <TextBlock Grid.Column="1" Classes="SectionTitle" Text="{Binding TitleColors}" HorizontalAlignment="Center" />
                <Border Grid.Column="2" Classes="SectionChevron">
                  <PathIcon Data="{Binding ColorsChevron}" Width="9" Height="9" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <StackPanel Spacing="10" IsVisible="{Binding IsColorsOpen}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto">
                <Grid ColumnDefinitions="168,*" ColumnSpacing="12" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding BrightnessLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Slider Grid.Column="1" Theme="{StaticResource PillSlider}" Minimum="-1" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Brightness, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="168,*" ColumnSpacing="12" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ContrastLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Slider Grid.Column="1" Theme="{StaticResource PillSlider}" Minimum="-1" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Contrast, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="168,*" ColumnSpacing="12" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SaturationLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Slider Grid.Column="1" Theme="{StaticResource PillSlider}" Minimum="-1" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Saturation, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="168,*" ColumnSpacing="12" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding WarmthLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Slider Grid.Column="1" Theme="{StaticResource PillSlider}" Minimum="-1" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Warmth, Mode=TwoWay}" />
                </Grid>
                <!-- How the output is handed to the screen (round 29): people
                     asked to pick it themselves - sRGB, linear sRGB or scRGB -
                     when the automatic choice does not suit a game. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="0" Grid.Row="2" ToolTip.Tip="{Binding Loc.LfColorSpaceHint}">
                  <TextBlock Text="{Binding Loc.LfColorSpace}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <ComboBox Grid.Column="1" Classes="GlassComboBox" Width="170" MinWidth="170" VerticalAlignment="Center"
                            ItemsSource="{Binding ColorSpaces}" SelectedIndex="{Binding ColorSpaceIndex, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Grid.Column="1" Grid.Row="2" IsEnabled="{Binding CanHdrSwitch}"
                      ToolTip.Tip="{Binding Loc.LfHdrSwitchHint}" ToolTip.ShowOnDisabled="True">
                  <TextBlock Text="{Binding Loc.LfHdrCompatibility}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" CornerRadius="19" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                    <UniformGrid Columns="2">
                      <Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding !Hdr}" Content="{Binding Loc.LfOff}" Command="{Binding HdrOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      <Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding Hdr}" Content="{Binding Loc.LfOn}" Command="{Binding HdrOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </UniformGrid>
                  </Border>
                </Grid>
              </Grid>
              <Button Classes="SegmentedTab" Content="{Binding Loc.LfColorsReset}" Command="{Binding ResetColorsCommand}"
                      IsVisible="{Binding HasColors}" Padding="12,4" Focusable="False" HorizontalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ================= FPS / VRR (folded) ================= -->
        <Border x:Name="FpsCard" Classes="ScreenCard" IsVisible="{Binding ShowFps}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="10">
            <Button Classes="SectionHeader" Click="OnToggleSection" Tag="fps" Cursor="Hand">
              <Grid ColumnDefinitions="24,*,24">
                <TextBlock Grid.Column="1" Classes="SectionTitle" Text="FPS / VRR" HorizontalAlignment="Center" />
                <Border Grid.Column="2" Classes="SectionChevron">
                  <PathIcon Data="{Binding FpsChevron}" Width="9" Height="9" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <StackPanel Spacing="10" IsVisible="{Binding IsFpsOpen}">
              <!-- The two switches side by side, and the limit's bar the whole
                   width under them. -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Grid ColumnDefinitions="*,Auto" Grid.Column="0" ToolTip.Tip="{Binding Loc.LfVrrHint}">
                  <!-- BETA: it depends on the driver applying VRR to windows,
                       which many do not. -->
                  <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Loc.LfVrr}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Background="#26F59E0B" BorderBrush="#55F59E0B" BorderThickness="1" CornerRadius="6" Padding="5,0" VerticalAlignment="Center">
                      <TextBlock Text="BETA" FontSize="8.5" FontWeight="Bold" Foreground="#FCD34D" LetterSpacing="0.5" />
                    </Border>
                  </Grid>
                  <Border Grid.Column="1" CornerRadius="19" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                    <UniformGrid Columns="2">
                      <Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding !Vrr}" Content="{Binding Loc.LfOff}" Command="{Binding VrrOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      <Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding Vrr}" Content="{Binding Loc.LfOn}" Command="{Binding VrrOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </UniformGrid>
                  </Border>
                </Grid>
                <!-- The FPS counter: drawn by the worker in the frame itself
                     (round 28) - the base frames, and with a generator the
                     frames after it. The overlay's header carries the same button. -->
                <Grid ColumnDefinitions="*,Auto" Grid.Column="1" ToolTip.Tip="{Binding Loc.LfFpsHint}">
                  <TextBlock Text="{Binding Loc.LfFpsCounter}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" CornerRadius="19" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                    <UniformGrid Columns="2">
                      <Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding !IsFpsCounterOn}" Content="{Binding Loc.LfOff}" Command="{Binding FpsCounterOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      <Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding IsFpsCounterOn}" Content="{Binding Loc.LfOn}" Command="{Binding FpsCounterOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </UniformGrid>
                  </Border>
                </Grid>
              </Grid>
              <!-- The frame limit: the most frames a second shown. -->
              <StackPanel Spacing="8" ToolTip.Tip="{Binding Loc.LfFrameLimitHint}">
                <TextBlock Text="{Binding FrameLimitLabel}" TextTrimming="CharacterEllipsis" />
                <Slider Theme="{StaticResource PillSlider}" Minimum="0" Maximum="{Binding FrameLimitMaximum}" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FrameLimitIndex, Mode=TwoWay}" />
              </StackPanel>
              <TextBlock Text="{Binding Loc.LfVrrActive}" IsVisible="{Binding IsVrrActive}" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Loc.LfVrrInactive}" IsVisible="{Binding IsVrrInactive}" FontSize="12" Foreground="#F59E0B" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ================= COMPARISON ================= -->
        <Border x:Name="ComparisonCard" Classes="ScreenCard" IsVisible="{Binding ShowComparison}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="10">
            <TextBlock Classes="SectionTitle" Text="{Binding TitleComparison}" HorizontalAlignment="Center" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Loc.LfBeforeAfterWipe}" />
              <TextBlock Grid.Column="1" Text="{Binding Split, StringFormat={}{0:P0}}" />
            </Grid>
            <Slider Theme="{StaticResource PillSlider}" Minimum="0" Maximum="1" Value="{Binding Split, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True">
              <Slider.Resources>
                <SolidColorBrush x:Key="PillSliderFill" Color="#76B900" />
                <SolidColorBrush x:Key="PillSliderFillPointerOver" Color="#8ED600" />
              </Slider.Resources>
            </Slider>
          </StackPanel>
        </Border>

        <!-- ================= Folded away: presets, settings, record, overlay ================= -->
        <Border x:Name="PresetsCard" Classes="ScreenCard" IsEnabled="{Binding IsReady}" IsVisible="{Binding ShowPresets}">
          <StackPanel Spacing="10">
            <Button Classes="SectionHeader" Click="OnToggleSection" Tag="presets" Cursor="Hand">
              <Grid ColumnDefinitions="24,*,24">
                <TextBlock Grid.Column="1" Classes="SectionTitle" Text="{Binding TitlePresets}" HorizontalAlignment="Center" />
                <Border Grid.Column="2" Classes="SectionChevron">
                  <PathIcon Data="{Binding PresetsChevron}" Width="9" Height="9" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <StackPanel Spacing="12" IsVisible="{Binding IsPresetsOpen}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Loc.LfPresetName}" />
                  <TextBox Text="{Binding PresetName, Mode=TwoWay}" PlaceholderText="{Binding Loc.LfNameYourPreset}" MaxLength="80" CornerRadius="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="{Binding Loc.LfSavedPresets}" />
                  <ComboBox Classes="GlassComboBox" ItemsSource="{Binding SavedPresets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" PlaceholderText="{Binding Loc.LfChooseAPreset}" MaxDropDownHeight="240" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Button Classes="AppleSecondaryBtn" Content="{Binding Loc.LfSaveNew}" Command="{Binding SavePresetCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Grid.Column="1" Classes="AppleSecondaryBtn" Content="{Binding Loc.LfUpdateSelected}" Command="{Binding UpdatePresetCommand}" IsEnabled="{Binding CanDeletePreset}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Grid.Column="2" Classes="AppleSecondaryBtn" Content="{Binding Loc.LfApply}" Command="{Binding ApplyPresetCommand}" IsEnabled="{Binding CanDeletePreset}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Grid.Column="3" Classes="AppleSecondaryBtn" Content="{Binding Loc.LfDelete}" Command="{Binding DeletePresetCommand}" IsEnabled="{Binding CanDeletePreset}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border x:Name="SettingsCard" Classes="ScreenCard" IsEnabled="{Binding IsReady}" IsVisible="{Binding ShowSettings}">
          <StackPanel Spacing="10">
            <Button Classes="SectionHeader" Click="OnToggleSection" Tag="settings" Cursor="Hand">
              <Grid ColumnDefinitions="24,*,24">
                <TextBlock Grid.Column="1" Classes="SectionTitle" Text="{Binding TitleSettings}" HorizontalAlignment="Center" />
                <Border Grid.Column="2" Classes="SectionChevron">
                  <PathIcon Data="{Binding SettingsChevron}" Width="9" Height="9" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowSpacing="10" RowDefinitions="Auto,Auto,Auto" IsVisible="{Binding IsSettingsOpen}">
              <StackPanel Spacing="8" Grid.Column="0" Grid.Row="0">
                <TextBlock Text="{Binding Loc.LfProcessingGpu}" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Gpus}" SelectedItem="{Binding Gpu, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="1" Grid.Row="0">
                <TextBlock Text="{Binding Loc.LfDisplay}" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Monitors}" SelectedItem="{Binding Monitor, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Spacing="8" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding MotionTip}" ToolTip.ShowOnDisabled="True">
                <TextBlock Text="{Binding Loc.LfMotionEstimation}" />
                <ComboBox Classes="GlassComboBox" ItemsSource="{Binding MotionBackends}" SelectedIndex="{Binding MotionBackendIndex, Mode=TwoWay}"
                          IsEnabled="{Binding CanPickMotion}" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" Grid.Column="1" Grid.Row="1" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Loc.LfSkipStaticFrames}" VerticalAlignment="Center" />
                <Border Grid.Column="1" CornerRadius="19" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                  <UniformGrid Columns="2">
                    <Button Classes="SegmentedTab" Classes.Active="{Binding !SkipStatic}" Content="{Binding Loc.LfOff}" Command="{Binding SkipStaticOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Classes="SegmentedTab" Classes.Active="{Binding SkipStatic}" Content="{Binding Loc.LfOn}" Command="{Binding SkipStaticOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </UniformGrid>
                </Border>
              </Grid>
              <!-- Round 37: "Select window", a choice again (off = the whole screen). -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Center">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Loc.LfWindowPick}" />
                  <TextBlock Text="{Binding Loc.LfWindowPickHint}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="19" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                  <UniformGrid Columns="2">
                    <Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding !IsWindowPickOn}" Content="{Binding Loc.LfOff}" Command="{Binding WindowPickOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Classes="SegmentedTab" Focusable="False" Classes.Active="{Binding IsWindowPickOn}" Content="{Binding Loc.LfOn}" Command="{Binding WindowPickOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </UniformGrid>
                </Border>
              </Grid>
            </Grid>
          </StackPanel>
        </Border>
        <Border x:Name="CaptureCard" Classes="ScreenCard" IsVisible="{Binding ShowCapture}" IsEnabled="{Binding IsReady}">
          <StackPanel Spacing="10">
            <Button Classes="SectionHeader" Click="OnToggleSection" Tag="capture" Cursor="Hand">
              <Grid ColumnDefinitions="24,*,24">
                <TextBlock Grid.Column="1" Classes="SectionTitle" Text="{Binding TitleRecord}" HorizontalAlignment="Center" />
                <Border Grid.Column="2" Classes="SectionChevron">
                  <PathIcon Data="{Binding CaptureChevron}" Width="9" Height="9" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <StackPanel Spacing="8" IsVisible="{Binding IsCaptureOpen}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsEnabled="{Binding CanConfigureCapture}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Loc.LfMicrophone}" />
                  <ComboBox Classes="GlassComboBox" ItemsSource="{Binding Microphones}" SelectedItem="{Binding Microphone, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="{Binding Loc.LfRecordingRate}" />
                  <ComboBox Classes="GlassComboBox" ItemsSource="{Binding RecordingRates}" SelectedIndex="{Binding RecordingRateIndex, Mode=TwoWay}" />
                </StackPanel>
              </Grid>
              <CheckBox Content="{Binding Loc.LfSystemAudio}" IsChecked="{Binding SystemAudio, Mode=TwoWay}" IsEnabled="{Binding CanConfigureCapture}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsEnabled="{Binding CanConfigureCapture}">
                <TextBox Text="{Binding OutputFolder, Mode=TwoWay}" PlaceholderText="Output folder" CornerRadius="12" />
                <Button Grid.Column="1" Classes="AppleSecondaryBtn" Content="{Binding Loc.LfChooseFolder}" Click="OnChooseOutput" />
              </Grid>
              <Grid ColumnDefinitions="*,*,Auto">
                <Button Classes="AppleSecondaryBtn" Content="{Binding ScreenshotButtonText}" Command="{Binding ScreenshotCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" />
                <Button Grid.Column="1" Classes="AppleSecondaryBtn" Content="{Binding RecordLabel}" Command="{Binding RecordCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding RecordingTime}" IsVisible="{Binding IsRecording}" Foreground="#EF7777" VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
              <TextBlock Text="{Binding CaptureMessage}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Loc.LfObsOutputSpout2}" VerticalAlignment="Center" />
                  <!-- Who this is for, and a guide one tap away. -->
                  <Border Background="#1A7CFFC4" BorderBrush="#447CFFC4" BorderThickness="1" CornerRadius="8"
                          Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc.LfForCreators}" FontSize="10" FontWeight="Bold" Foreground="#7CFFC4" />
                  </Border>
                  <Button Classes="SegmentedTab" Padding="12,4" VerticalAlignment="Center" Content="{Binding Loc.LfObsGuide}">
                    <Button.Flyout>
                      <Flyout Placement="TopEdgeAlignedLeft">
                        <Border Classes="ShortcutPanel">
                          <StackPanel Spacing="12" Width="440">
                            <TextBlock Text="{Binding Loc.LfObsGuideTitle}" FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Loc.LfObsSteps}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="20" />
                            <Button Classes="ApplePrimaryBtn" Content="{Binding Loc.LfGetObsSpout2Plugin}"
                                    Command="{Binding OpenObsPluginCommand}" HorizontalAlignment="Left" />
                          </StackPanel>
                        </Border>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="19" Padding="3" Background="#0C1014" BorderBrush="#20FFFFFF" BorderThickness="1" Width="136" Height="38" VerticalAlignment="Center">
                  <UniformGrid Columns="2">
                    <Button Classes="SegmentedTab" Classes.Active="{Binding !ExternalOutput}" Content="{Binding Loc.LfOff}" Command="{Binding ExternalOutputOffCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Classes="SegmentedTab" Classes.Active="{Binding ExternalOutput}" Content="{Binding Loc.LfOn}" Command="{Binding ExternalOutputOnCommand}" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </UniformGrid>
                </Border>
              </Grid>
              <TextBlock x:Name="ObsFooter" Text="{Binding Loc.LfObsHelp}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
              <Button Classes="AppleSecondaryBtn" Content="{Binding Loc.LfGetObsSpout2Plugin}" Command="{Binding OpenObsPluginCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- The overlay and the three shortcuts: down here since round 29, no
             longer in the top bar. Each shortcut is its own button with its
             key on its face; clicking one opens a small panel to change that
             key - typed in, or picked from a few that are known to be free. -->
        <Border x:Name="OverlayCard" Classes="ScreenCard" IsVisible="{Binding ShowOverlay}">
          <StackPanel Spacing="10">
            <Button Classes="SectionHeader" Click="OnToggleSection" Tag="overlay" Cursor="Hand">
              <Grid ColumnDefinitions="24,*,24">
                <TextBlock Grid.Column="1" Classes="SectionTitle" Text="{Binding TitleOverlay}" HorizontalAlignment="Center" />
                <Border Grid.Column="2" Classes="SectionChevron">
                  <PathIcon Data="{Binding OverlayChevron}" Width="9" Height="9" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <StackPanel Spacing="10" IsVisible="{Binding IsOverlayOpen}">
              <WrapPanel>
                <Button Classes="ApplePrimaryBtn" Content="{Binding Loc.LfOpenOverlayNow}" Click="OnOpenOverlay" Margin="0,0,8,8" Focusable="False" />
                <Button Classes="AppleSecondaryBtn" Content="{Binding OverlayButtonText}" Margin="0,0,8,8">
                  <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedLeft">
                      <!-- Keys land here while the cap below is listening. -->
                      <Border Classes="ShortcutPanel" KeyDown="OnHotkeyPanelKeyDown">
                        <StackPanel Spacing="10" Width="300">
                          <TextBlock Text="{Binding Loc.LfShortcutOverlay}" FontWeight="Bold" FontSize="13.5" />
                          <TextBlock Text="{Binding Loc.LfShortcutHintOverlay}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                          <Button Classes="ShortcutCap" Tag="overlay" Click="OnCaptureHotkey" Content="{Binding OverlayCapText}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                          <TextBlock Text="{Binding Loc.LfShortcutChange}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Loc.LfShortcutPresets}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                          <WrapPanel>
                            <Button Classes="SegmentedTab" Tag="overlay|4|79" Click="OnHotkeyPreset" Content="Shift+O" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="overlay|1|79" Click="OnHotkeyPreset" Content="Alt+O" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="overlay|6|79" Click="OnHotkeyPreset" Content="Ctrl+Shift+O" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="overlay|0|118" Click="OnHotkeyPreset" Content="F7" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="overlay|0|119" Click="OnHotkeyPreset" Content="F8" Padding="11,5" Margin="0,0,6,6" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <Button Classes="AppleSecondaryBtn" Content="{Binding ScreenshotButtonText}" Margin="0,0,8,8">
                  <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedLeft">
                      <!-- Keys land here while the cap below is listening. -->
                      <Border Classes="ShortcutPanel" KeyDown="OnHotkeyPanelKeyDown">
                        <StackPanel Spacing="10" Width="300">
                          <TextBlock Text="{Binding Loc.LfShortcutShot}" FontWeight="Bold" FontSize="13.5" />
                          <TextBlock Text="{Binding Loc.LfShortcutHintShot}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                          <Button Classes="ShortcutCap" Tag="shot" Click="OnCaptureHotkey" Content="{Binding ScreenshotCapText}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                          <TextBlock Text="{Binding Loc.LfShortcutChange}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Loc.LfShortcutPresets}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                          <WrapPanel>
                            <Button Classes="SegmentedTab" Tag="shot|0|121" Click="OnHotkeyPreset" Content="F10" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="shot|0|122" Click="OnHotkeyPreset" Content="F11" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="shot|1|83" Click="OnHotkeyPreset" Content="Alt+S" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="shot|6|83" Click="OnHotkeyPreset" Content="Ctrl+Shift+S" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="shot|4|121" Click="OnHotkeyPreset" Content="Shift+F10" Padding="11,5" Margin="0,0,6,6" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <Button Classes="AppleSecondaryBtn" Content="{Binding RecordButtonText}" Margin="0,0,8,8">
                  <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedLeft">
                      <!-- Keys land here while the cap below is listening. -->
                      <Border Classes="ShortcutPanel" KeyDown="OnHotkeyPanelKeyDown">
                        <StackPanel Spacing="10" Width="300">
                          <TextBlock Text="{Binding Loc.LfShortcutRecord}" FontWeight="Bold" FontSize="13.5" />
                          <TextBlock Text="{Binding Loc.LfShortcutHintRecord}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                          <Button Classes="ShortcutCap" Tag="record" Click="OnCaptureHotkey" Content="{Binding RecordCapText}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                          <TextBlock Text="{Binding Loc.LfShortcutChange}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Loc.LfShortcutPresets}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                          <WrapPanel>
                            <Button Classes="SegmentedTab" Tag="record|4|120" Click="OnHotkeyPreset" Content="Shift+F9" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="record|4|122" Click="OnHotkeyPreset" Content="Shift+F11" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="record|1|82" Click="OnHotkeyPreset" Content="Alt+R" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="record|6|82" Click="OnHotkeyPreset" Content="Ctrl+Shift+R" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="record|0|122" Click="OnHotkeyPreset" Content="F11" Padding="11,5" Margin="0,0,6,6" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <Button Classes="AppleSecondaryBtn" Content="{Binding DlssButtonText}" Margin="0,0,8,8">
                  <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedLeft">
                      <!-- Keys land here while the cap below is listening. -->
                      <Border Classes="ShortcutPanel" KeyDown="OnHotkeyPanelKeyDown">
                        <StackPanel Spacing="10" Width="300">
                          <TextBlock Text="{Binding Loc.LfShortcutDlss}" FontWeight="Bold" FontSize="13.5" />
                          <TextBlock Text="{Binding Loc.LfShortcutHintDlss}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                          <Button Classes="ShortcutCap" Tag="dlss" Click="OnCaptureHotkey" Content="{Binding DlssCapText}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                          <TextBlock Text="{Binding Loc.LfShortcutChange}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Loc.LfShortcutPresets}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                          <WrapPanel>
                            <Button Classes="SegmentedTab" Tag="dlss|0|117" Click="OnHotkeyPreset" Content="F6" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="dlss|0|120" Click="OnHotkeyPreset" Content="F9" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="dlss|4|117" Click="OnHotkeyPreset" Content="Shift+F6" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="dlss|1|68" Click="OnHotkeyPreset" Content="Alt+D" Padding="11,5" Margin="0,0,6,6" />
                            <Button Classes="SegmentedTab" Tag="dlss|6|68" Click="OnHotkeyPreset" Content="Ctrl+Shift+D" Padding="11,5" Margin="0,0,6,6" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
